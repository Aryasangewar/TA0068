{
  "version": 2,
  "buildCommand": "cd docuflux-frontend && npm install && npm run build",
  "outputDirectory": "docuflux-frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
